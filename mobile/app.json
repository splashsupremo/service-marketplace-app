{
  "expo": {
    "name": "ServeNaija",
    "slug": "servenaija",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#ffffff",
      "translucent": false
    },
    "extra": {
      "supabaseUrl": "https://hdezcdqrygamvlxroagj.supabase.co",
      "supabaseAnonKey": "sb_publishable_b6kLlg88BSk_XgaGzzDCjw_Xmz1eYhi"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.servenaija.app"
    },
    "android": {
      "package": "com.servenaija.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#0A84FF",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 300,
            "resizeMode": "contain",
            "backgroundColor": "#0A0A0A"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}